    {
      "id": "step_labels_column",
      "type": "text",
      "x": 480,
      "y": 70,
      "width": 300,
      "height": 480,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 46,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Step 1: Create the window.\nSets OpenGL hints (4.1 core or ES 3.0),\ncreates GLFWwindow, makes context\ncurrent, sets vsync interval.\n\n\n\nStep 2: Load OpenGL function pointers.\nOpenGLContext calls gladLoadGLLoader\nwith glfwGetProcAddress. After this all\ngl* calls are valid.\n\n\n\nStep 3: Enable event forwarding.\nRegisters 4 GLFW callbacks that push\ntyped vne::events::* into EventManager.\n\n\n\nStep 4: Attach layers.\nEach layer receives AppContext with\npointers to window, renderer, device.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 470,
      "containerId": null,
      "originalText": "Step 1: Create the window.\nSets OpenGL hints (4.1 core or ES 3.0),\ncreates GLFWwindow, makes context\ncurrent, sets vsync interval.\n\n\n\nStep 2: Load OpenGL function pointers.\nOpenGLContext calls gladLoadGLLoader\nwith glfwGetProcAddress. After this all\ngl* calls are valid.\n\n\n\nStep 3: Enable event forwarding.\nRegisters 4 GLFW callbacks that push\ntyped vne::events::* into EventManager.\n\n\n\nStep 4: Attach layers.\nEach layer receives AppContext with\npointers to window, renderer, device.",
      "lineHeight": 1.5
    }
  ],
